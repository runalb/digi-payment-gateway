  "item": [
    {
      "name": "Auth",
      "description": "auth.controller.AuthController — all routes public.",
      "item": [
        {
          "name": "Login (email + password)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/auth/login",
            "description": "AuthLoginRequest → AuthLoginResponse. Saves tokens and userId from JWT.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{emailId}}\",\n  \"password\": \"{{password}}\"\n}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "function saveAuthFromResponse() {",
                  "  if (pm.response.code !== 200) return;",
                  "  const json = pm.response.json();",
                  "  if (json.accessToken) {",
                  "    pm.collectionVariables.set('accessToken', json.accessToken);",
                  "    try {",
                  "      const payload = JSON.parse(atob(json.accessToken.split('.')[1]));",
                  "      if (payload.sub) pm.collectionVariables.set('userId', String(payload.sub));",
                  "    } catch (e) {}",
                  "  }",
                  "  if (json.refreshToken) pm.collectionVariables.set('refreshToken', json.refreshToken);",
                  "}",
                  "saveAuthFromResponse();"
                ]
              }
            }
          ]
        },
        {
          "name": "Login email — request OTP",
